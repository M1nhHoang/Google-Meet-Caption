{
  "manifest_version": 3,
  "name": "MeetCap — ghi phụ đề & ảnh slide",
  "version": "0.1.0",
  "description": "Tự ghi phụ đề và chụp slide khi bạn vào Google Meet. Mọi thứ lưu trong máy.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "clipboardWrite", "scripting"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "content/selectors.js",
        "content/captions.js",
        "content/frames.js",
        "content/cc-toggle.js",
        "content/hud.js",
        "content/detector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MeetCap"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
